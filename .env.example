# ==============================================================================
# Freightly Environment Configuration
# ==============================================================================

# Database Connection URL (PostgreSQL)
# Local Docker Postgres: postgres://freightly:freightly@localhost:5434/freightly
# Render Postgres: provided automatically via Render Blueprint
DATABASE_URL=postgres://freightly:freightly@localhost:5434/freightly

# Test Database Connection URL (for integration tests)
DATABASE_URL_TEST=postgres://freightly:freightly@localhost:5434/freightly_test

# Secret used to sign and verify JWT authentication tokens (min 32 characters recommended)
# Generated automatically in production via Render Blueprint
JWT_SECRET=dev-jwt-secret-replace-in-production-min-32-chars

# OpenRouteService API Key (for real highway routing and geocoding)
# Obtain a free key from https://openrouteservice.org/dev/#/signup
ORS_API_KEY=your-ors-api-key-here

# Email address of the initial administrator
# The first account registered with this email receives role 'admin'
ADMIN_EMAIL=admin@example.com

# HTTP Server Port (default: 3001)
PORT=3001

# Environment ('development' | 'production' | 'test')
NODE_ENV=development

# Allowed CORS Origin for API requests
CORS_ORIGIN=http://localhost:5173
